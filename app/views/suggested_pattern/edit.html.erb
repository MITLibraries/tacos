<div class="wrap-outer-breadcrumb layout-band" role="navigation" aria-label="breadcrumbs">
  <div class="breadcrumbs">
    <a href="/" title="Home">Home</a>
    »
    <a href="/suggestions" title="Suggestions">Suggestions</a>
    »
    <%= link_to( "Patterns", suggested_pattern_path ) %>
    »
    <%= @resource.title %>
  </div>
</div>

<h3>Edit Suggested Pattern</h3>

<%= form_with model: @resource, url: suggested_pattern_update_path(@resource) do |f| %>
  <div class="field-wrap">
    <%= f.label :title, class: "field-label" %>
    <%= f.text_field :title, class: "field field-text wide" %>
  </div>
  <div class="field-wrap">
    <%= f.label :url, class: "field-label" %>
    <%= f.text_field :url, class: "field field-text wide" %>
  </div>
  <div class="field-wrap">
    <%= f.label :shortcode, class: "field-label" %>
    <%= f.text_field :shortcode, class: "field field-text wide" %>
  </div>
  <div class="field-wrap">
    <%= f.label :pattern, class: "field-label" %>
    <%= f.text_field :pattern, class: "field field-text wide" %>
  </div>
  <div class="field-wrap">
    <%= f.submit "Update Suggested Pattern", class: "btn button-primary" %>
  </div>
<% end %>
