<div class="wrap-outer-breadcrumb layout-band">
  <div class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
    <a href="/" title="Home">Home</a>
    »
    <a href="/suggestions" title="Suggestions">Suggestions</a>
    »
    Resources
  </div>
</div>

<h3>Suggested Resources</h3>

<table class="table table-simplified table-cozy">
  <thead>
    <tr>
      <th scope="col">Suggestion</th>
      <th scope="col">URL</th>
      <th scope="col">Terms</th>
    </tr>
  </thead>
  <tbody>
<% @records.each do |record| %>
    <tr>
      <td><%= record.title %></td>
      <td><%= record.url %></td>
      <td><%= record.terms.count %></td>
    </tr>
<% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="3"><%= @records.count %> total resources</td>
    </tr>
  </tfoot>
</table>
